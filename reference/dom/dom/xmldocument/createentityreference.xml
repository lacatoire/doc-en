<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="dom-xmldocument.createentityreference" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Dom\XMLDocument::createEntityReference</refname>
  <refpurpose>Creates a new entity reference node</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Dom\\XMLDocument">
   <modifier>public</modifier> <type>Dom\EntityReference</type><methodname>Dom\XMLDocument::createEntityReference</methodname>
   <methodparam><type>string</type><parameter>name</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Creates a new <classname>Dom\EntityReference</classname> node.
   The node is not inserted into the document; use one of the insertion
   methods for that.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>name</parameter></term>
    <listitem>
     <simpara>
      The name of the entity to reference.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   The new <classname>Dom\EntityReference</classname> node.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     Throws a <exceptionname>Dom\DOMException</exceptionname> if
     <parameter>name</parameter> is not a valid <acronym>XML</acronym> name.
    </simpara>
   </listitem>
  </itemizedlist>
 </refsect1>

</refentry>
