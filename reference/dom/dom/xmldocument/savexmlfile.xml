<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="dom-xmldocument.savexmlfile" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Dom\XMLDocument::saveXmlFile</refname>
  <refpurpose>Serializes the document to a file as <acronym>XML</acronym></refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Dom\\XMLDocument">
   <modifier>public</modifier> <type class="union"><type>int</type><type>false</type></type><methodname>Dom\XMLDocument::saveXmlFile</methodname>
   <methodparam><type>string</type><parameter>filename</parameter></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>options</parameter><initializer>0</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Serializes the document as <acronym>XML</acronym> and writes it to the
   given file.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>filename</parameter></term>
    <listitem>
     <simpara>
      The path of the file to write to.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>options</parameter></term>
    <listitem>
     &dom.parameters.serialize.options;
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   The number of bytes written, or &false; on failure.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Dom\XMLDocument::saveXml</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
