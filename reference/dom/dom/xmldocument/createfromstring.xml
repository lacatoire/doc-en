<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="dom-xmldocument.createfromstring" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Dom\XMLDocument::createFromString</refname>
  <refpurpose>Parses an <acronym>XML</acronym> document from a string</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Dom\\XMLDocument">
   <modifier>public</modifier> <modifier>static</modifier> <type>Dom\XMLDocument</type><methodname>Dom\XMLDocument::createFromString</methodname>
   <methodparam><type>string</type><parameter>source</parameter></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>options</parameter><initializer>0</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>overrideEncoding</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Parses an <acronym>XML</acronym> document from a string.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>source</parameter></term>
    <listitem>
     <simpara>
      The <acronym>XML</acronym> source to parse.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>options</parameter></term>
    <listitem>
     &dom.parameter.compliant.options;
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>overrideEncoding</parameter></term>
    <listitem>
     &dom.parameter.compliant.encoding;
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   The parsed document as a <classname>Dom\XMLDocument</classname> instance.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     Throws a <exceptionname>Dom\DOMException</exceptionname> if the document
     is not well-formed.
    </simpara>
   </listitem>
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="dom-xmldocument.createfromstring.example.basic">
   <title><methodname>Dom\XMLDocument::createFromString</methodname> example</title>
   <simpara>
    Parses a document and serializes it again.
   </simpara>
   <programlisting role="php">
<![CDATA[
<?php
$document = Dom\XMLDocument::createFromString('<a><b/></a>');
echo $document->saveXml();
?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
<?xml version="1.0" encoding="UTF-8"?>
<a><b/></a>
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Dom\XMLDocument::createFromFile</methodname></member>
   <member><methodname>Dom\XMLDocument::createEmpty</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
