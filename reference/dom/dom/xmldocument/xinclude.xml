<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="dom-xmldocument.xinclude" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Dom\XMLDocument::xinclude</refname>
  <refpurpose>Substitutes XIncludes in the document</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Dom\\XMLDocument">
   <modifier>public</modifier> <type>int</type><methodname>Dom\XMLDocument::xinclude</methodname>
   <methodparam choice="opt"><type>int</type><parameter>options</parameter><initializer>0</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Substitutes the XInclude nodes of the document by the content they refer
   to.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>options</parameter></term>
    <listitem>
     &dom.parameter.compliant.options;
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   The number of substitutions performed.
  </simpara>
 </refsect1>

</refentry>
