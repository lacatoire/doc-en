<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.dba-sync">
 <refnamediv>
  <refname>dba_sync</refname>
  <refpurpose>Synchronize database</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>dba_sync</methodname>
   <methodparam><type>Dba\Connection</type><parameter>dba</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   <function>dba_sync</function> synchronizes the database, when the
   handler supports it.
  </simpara>
  <simpara>
   The following handlers actually trigger a physical write to the disk:
  </simpara>
  <itemizedlist>
   <listitem>
    <simpara>
     <literal>gdbm</literal>
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <literal>db2</literal>, <literal>db3</literal>, <literal>db4</literal>
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <literal>qdbm</literal>
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <literal>tcadb</literal>
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <literal>lmdb</literal>; on failure this is the only handler that
     reports the underlying error by raising an
     <constant>E_WARNING</constant>, the other handlers failing silently
    </simpara>
   </listitem>
  </itemizedlist>
  <simpara>
   On every other handler (<literal>cdb</literal>, <literal>db1</literal>,
   <literal>dbm</literal>, <literal>ndbm</literal>, <literal>inifile</literal>,
   <literal>flatfile</literal>), <function>dba_sync</function> does nothing
   at all and unconditionally returns &true;.
  </simpara>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>dba</parameter></term>
    <listitem>
     <simpara>
      &dba.parameter.dba;
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.success;
  </simpara>
 </refsect1>

