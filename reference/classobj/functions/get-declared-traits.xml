<refentry xml:id="function.get-declared-traits" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>get_declared_traits</refname>
  <refpurpose>Returns an array of all declared traits</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>array</type><methodname>get_declared_traits</methodname>
   <void />
  </methodsynopsis>
  <para>
   Gets the declared traits.
  </para>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Returns an array with names of all declared traits in values.
  </para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>get_declared_traits</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php

trait Hello {
    public function sayHello()
    {
        echo 'Hello ';
    }
}

class MyHelloWorld {
    use Hello;
}

print_r(get_declared_traits());
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
Array
(
    [0] => Hello
)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>class_uses</function></member>
    <member><function>trait_exists</function></member>
    <member><function>get_declared_classes</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

