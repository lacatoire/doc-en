<refentry xml:id="function.ldap-sasl-bind" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>ldap_sasl_bind</refname>
  <refpurpose>Bind to LDAP directory using SASL</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>ldap_sasl_bind</methodname>
   <methodparam><type>LDAP\Connection</type><parameter>ldap</parameter></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>dn</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><modifier role="attribute">#[\SensitiveParameter]</modifier><type class="union"><type>string</type><type>null</type></type><parameter>password</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>mech</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>realm</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>authc_id</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>authz_id</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>props</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Binds to the LDAP directory using <acronym>SASL</acronym> authentication.
   Use <function>ldap_bind</function> for a simple bind.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>ldap</parameter></term>
     <listitem>
      <simpara>
       &ldap.parameter.ldap;
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>dn</parameter></term>
     <listitem>
      <simpara>
       The bind <acronym>DN</acronym>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>password</parameter></term>
     <listitem>
      <simpara>
       The password used as credential for the bind.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>mech</parameter></term>
     <listitem>
      <simpara>
       The <acronym>SASL</acronym> mechanism name, for example
       <literal>DIGEST-MD5</literal>. If &null;, the value of the
       <constant>LDAP_OPT_X_SASL_MECH</constant> connection option is used.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>realm</parameter></term>
     <listitem>
      <simpara>
       The <acronym>SASL</acronym> realm. If &null;, the value of the
       <constant>LDAP_OPT_X_SASL_REALM</constant> connection option is used.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>authc_id</parameter></term>
     <listitem>
      <simpara>
       The authentication identity. If &null;, the value of the
       <constant>LDAP_OPT_X_SASL_AUTHCID</constant> connection option is used.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>authz_id</parameter></term>
     <listitem>
      <simpara>
       The authorization identity. If &null;, the value of the
       <constant>LDAP_OPT_X_SASL_AUTHZID</constant> connection option is used.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>props</parameter></term>
     <listitem>
      <simpara>
       A <acronym>SASL</acronym> security properties string. If not &null;,
       it is applied to the connection as the
       <constant>LDAP_OPT_X_SASL_SECPROPS</constant> option before binding.
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
  <simpara>
   The connection options mentioned above can be set with
   <function>ldap_set_option</function>.
  </simpara>
 </refsect1>
 
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   &return.success;
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   If the bind fails, an <constant>E_WARNING</constant> level error is emitted
   with the message <literal>Unable to bind to server</literal> followed by
   the <acronym>LDAP</acronym> error description, and &false; is returned.
  </simpara>
  <simpara>
   A <exceptionname>ValueError</exceptionname> is thrown if a string
   argument contains a null byte. An <exceptionname>Error</exceptionname>
   is thrown if the <parameter>ldap</parameter> connection has already been
   closed.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     &ldap.changelog.ldap-object;
     <row>
      <entry>8.0.0</entry>
      <entry>
       <parameter>dn</parameter>, <parameter>password</parameter>, <parameter>mech</parameter>,
       <parameter>realm</parameter>, <parameter>authc_id</parameter>, <parameter>authz_id</parameter>
       and <parameter>props</parameter> are nullable now.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  <note>
   <title>Requirement</title>
   <simpara>
    <function>ldap_sasl_bind</function> requires <acronym>SASL</acronym>
    support (<filename>sasl.h</filename>). Be sure
    <literal>--with-ldap-sasl</literal> is used when configuring PHP
    otherwise this function will be undefined.
   </simpara>
  </note>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>ldap_bind</function></member>
   <member><function>ldap_connect</function></member>
   <member><function>ldap_set_option</function></member>
  </simplelist>
 </refsect1>
</refentry>
