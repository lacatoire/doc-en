<refentry xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xml:id="function.sodium-crypto-kdf-derive-from-key">
 <refnamediv>
  <refname>sodium_crypto_kdf_derive_from_key</refname>
  <refpurpose>Derive a subkey</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>sodium_crypto_kdf_derive_from_key</methodname>
   <methodparam><type>int</type><parameter>subkey_length</parameter></methodparam>
   <methodparam><type>int</type><parameter>subkey_id</parameter></methodparam>
   <methodparam><type>string</type><parameter>context</parameter></methodparam>
   <methodparam><modifier role="attribute">#[\SensitiveParameter]</modifier><type>string</type><parameter>key</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Derive a subkey from a root key and additional context.
  </simpara>
  <simpara>
   Similar to <function>hash_hkdf</function>.
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>subkey_length</parameter></term>
    <listitem>
     <simpara>
      Length of the key to return (in bytes), between
      <link linkend="constant.sodium-crypto-kdf-bytes-min"><constant>SODIUM_CRYPTO_KDF_BYTES_MIN</constant></link> (16) and
      <link linkend="constant.sodium-crypto-kdf-bytes-max"><constant>SODIUM_CRYPTO_KDF_BYTES_MAX</constant></link> (64).
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>subkey_id</parameter></term>
    <listitem>
     <simpara>
      Return the Nth subkey from a given root key. Useful for seeking. It must be 0 or greater.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>context</parameter></term>
    <listitem>
     <simpara>
      Application-specific context, exactly
      <link linkend="constant.sodium-crypto-kdf-contextbytes"><constant>SODIUM_CRYPTO_KDF_CONTEXTBYTES</constant></link> (8) bytes long.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      The root key from which the subkey is derived, exactly
      <link linkend="constant.sodium-crypto-kdf-keybytes"><constant>SODIUM_CRYPTO_KDF_KEYBYTES</constant></link> (32) bytes long.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   A string of pseudorandom (raw binary) bytes.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     If <parameter>subkey_length</parameter> is outside the range described above, a <classname>SodiumException</classname> will be thrown.
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     If <parameter>subkey_id</parameter> is negative, a <classname>SodiumException</classname> will be thrown.
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     If <parameter>context</parameter> or <parameter>key</parameter> does not have the length described above, a <classname>SodiumException</classname> will be thrown.
    </simpara>
   </listitem>
  </itemizedlist>
 </refsect1>


</refentry>
