<refentry xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xml:id="function.sodium-pad">
 <refnamediv>
  <refname>sodium_pad</refname>
  <refpurpose>Add padding data</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>sodium_pad</methodname>
   <methodparam><modifier role="attribute">#[\SensitiveParameter]</modifier><type>string</type><parameter>string</parameter></methodparam>
   <methodparam><type>int</type><parameter>block_size</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Right-pad a string to a multiple of <parameter>block_size</parameter>.
   Timing-safe.
  </simpara>
  <simpara>
   At least one byte is always appended: a <literal>0x80</literal> byte followed
   by zero bytes (ISO/IEC 7816-4 padding). A string whose length is already a
   multiple of <parameter>block_size</parameter> therefore gets a whole extra block.
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>string</parameter></term>
    <listitem>
     <simpara>
      Unpadded string.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>block_size</parameter></term>
    <listitem>
     <simpara>
      The string will be padded until its length is the next multiple of the
      block size above the length of <parameter>string</parameter>.
      Must be greater than 0.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Padded string.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Throws a <classname>SodiumException</classname> if <parameter>block_size</parameter>
   is less than 1.
  </simpara>
 </refsect1>


</refentry>
