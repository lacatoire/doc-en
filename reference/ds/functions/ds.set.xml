<refentry xml:id="function.ds-set" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Ds\set</refname>
  <refpurpose>Creates a new <classname>Ds\Set</classname></refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>Ds\Set</type><methodname>Ds\set</methodname>
   <methodparam choice="opt"><type>mixed</type><parameter>values</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Creates a new <classname>Ds\Set</classname>, optionally filled with the
   given values. Equivalent to <code>new \Ds\Set($values)</code>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>values</parameter></term>
    <listitem>
     <simpara>
      A <classname>Traversable</classname> object or an array to use for the
      initial values.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   A new <classname>Ds\Set</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Throws an <exceptionname>InvalidArgumentException</exceptionname> if
   <parameter>values</parameter> is neither an array nor a
   <classname>Traversable</classname> object.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>Ds\set</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$set = \Ds\set([1, 2, 3]);

var_dump($set instanceof \Ds\Set);
?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
bool(true)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Ds\Set::__construct</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

