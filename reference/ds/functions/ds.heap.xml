<refentry xml:id="function.ds-heap" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Ds\heap</refname>
  <refpurpose>Creates a new <classname>Ds\Heap</classname></refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>Ds\Heap</type><methodname>Ds\heap</methodname>
   <methodparam choice="opt"><type>mixed</type><parameter>values</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><type class="union"><type>callable</type><type>null</type></type><parameter>comparator</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Creates a new <classname>Ds\Heap</classname>, optionally filled with the
   given values and using the given comparator. Equivalent to
   <code>new \Ds\Heap($values, $comparator)</code>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>values</parameter></term>
    <listitem>
     <simpara>
      A <classname>Traversable</classname> object or an array to use for the
      initial values.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>comparator</parameter></term>
    <listitem>
     <simpara>
      An optional comparison function to customize the heap ordering. When it
      is &null;, the heap behaves as a max-heap using standard comparison.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   A new <classname>Ds\Heap</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Throws an <exceptionname>InvalidArgumentException</exceptionname> if
   <parameter>values</parameter> is neither an array nor a
   <classname>Traversable</classname> object.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>Ds\heap</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$heap = \Ds\heap([1, 3, 2], function ($a, $b) {
    return $b <=> $a;
});

var_dump($heap->peek());
?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
int(1)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Ds\Heap::__construct</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

