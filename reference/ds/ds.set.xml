  <section role="changelog">
   &reftitle.changelog;
   <para>
    <informaltable>
     <tgroup cols="2">
      <thead>
       <row>
        <entry>&Version;</entry>
        <entry>&Description;</entry>
       </row>
      </thead>
      <tbody>
       <row>
        <entry>PECL ds 2.0.0</entry>
        <entry>
         The class no longer implements <literal>Ds\Collection</literal>.
        </entry>
       </row>
       <row>
        <entry>PECL ds 2.0.0</entry>
        <entry>
         <methodname>Ds\Set::copy</methodname> is now O(1), the contents being
         copied only when either the original or the copy is modified.
        </entry>
       </row>
       <row>
        <entry>PECL ds 1.3.0</entry>
        <entry>
         The class now implements <classname>ArrayAccess</classname>.
        </entry>
       </row>
       <row>
        <entry>PECL ds 1.2.7</entry>
        <entry>
         Added the <methodname>Ds\Set::map</methodname> method.
        </entry>
       </row>
       <row>
        <entry>PECL ds 1.2.0</entry>
        <entry>
         <constant>Ds\Set::MIN_CAPACITY</constant> changed from 16 to 8.
        </entry>
       </row>
      </tbody>
     </tgroup>
    </informaltable>
   </para>
  </section>

 </partintro>

