<refentry xml:id="ds-heap.count" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Ds\Heap::count</refname>
  <refpurpose>Returns the number of values in the heap</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>int</type><methodname>Ds\Heap::count</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   Returns the number of values in the heap. See
   <methodname>Countable::count</methodname>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   The number of values in the heap.
  </simpara>
 </refsect1>

</refentry>

