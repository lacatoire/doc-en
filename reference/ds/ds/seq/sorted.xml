<refentry xml:id="ds-seq.sorted" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Ds\Seq::sorted</refname>
  <refpurpose>Returns a sorted copy</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>Ds\Seq</type><methodname>Ds\Seq::sorted</methodname>
   <methodparam choice="opt"><type class="union"><type>callable</type><type>null</type></type><parameter>comparator</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
    Returns a sorted copy, using an optional <parameter>comparator</parameter> function.
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
     <term><parameter>comparator</parameter></term>
     <listitem>
      &sort.callback.description;
     </listitem>
    </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
    Returns a sorted copy of the seq.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>Ds\Seq::sorted</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$seq = new \Ds\Seq([4, 5, 1, 3, 2]);

print_r($seq->sorted());
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
Ds\Seq Object
(
    [0] => 1
    [1] => 2
    [2] => 3
    [3] => 4
    [4] => 5
)
]]>
   </screen>
  </example>
  <example>
   <title><function>Ds\Seq::sorted</function> example using a comparator</title>
   <programlisting role="php">
<![CDATA[
<?php
$seq = new \Ds\Seq([4, 5, 1, 3, 2]);

print_r($seq->sorted(function($a, $b) {
    return $b <=> $a;
}));
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
Ds\Seq Object
(
    [0] => 5
    [1] => 4
    [2] => 3
    [3] => 2
    [4] => 1
)
]]>
   </screen>
  </example>

 </refsect1>


 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Ds\Seq::sort</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

