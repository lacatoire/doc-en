<refentry xml:id="ds-set.offsetset" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Ds\Set::offsetSet</refname>
  <refpurpose>Adds a value to the set</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>void</type><methodname>Ds\Set::offsetSet</methodname>
   <methodparam><type>mixed</type><parameter>offset</parameter></methodparam>
   <methodparam><type>mixed</type><parameter>value</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Adds a value to the set, which is what <code>$set[] = $value</code> does.
   Only a &null; <parameter>offset</parameter> is supported: access by key is
   not supported by <classname>Ds\Set</classname>, so any other offset throws.
   This is equivalent to <methodname>Ds\Set::add</methodname>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>offset</parameter></term>
    <listitem>
     <simpara>
      Must be &null;. Any other value throws.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>value</parameter></term>
    <listitem>
     <simpara>
      The value to add.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Throws an <exceptionname>Error</exceptionname> with the message
   <literal>Array access by key is not supported</literal> if
   <parameter>offset</parameter> is not &null;.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Ds\Set::add</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

