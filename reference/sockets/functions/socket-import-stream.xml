<refentry xml:id="function.socket-import-stream" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>socket_import_stream</refname>
  <refpurpose>Import a stream</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>Socket</type><type>false</type></type><methodname>socket_import_stream</methodname>
   <methodparam><type>resource</type><parameter>stream</parameter></methodparam>
  </methodsynopsis>
  <para>
   Imports a stream that encapsulates a socket into a <classname>Socket</classname> instance.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>stream</parameter></term>
    <listitem>
     <para>
      The stream resource to import.
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Returns a <classname>Socket</classname> instance, or &false; on failure.
   When the stream is not a socket (a plain file, <literal>php://memory</literal>,
   a directory handle, ...) or has a read filter, an <constant>E_WARNING</constant> is emitted
   and &false; is returned.
  </para>
  <para>
   If data was already buffered in the stream, a <classname>Socket</classname> is returned
   with an <constant>E_WARNING</constant> saying that the buffered data was lost:
   <function>socket_recv</function> no longer sees it.
   The <classname>Socket</classname> and the stream share the same file descriptor,
   and the read buffer of the stream is switched off.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       On success, this function returns a <classname>Socket</classname> instance now;
       previously, a <type>resource</type> was returned.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>socket_import_stream</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$stream = stream_socket_server("udp://0.0.0.0:58380", $errno, $errstr, STREAM_SERVER_BIND); 
$sock   = socket_import_stream($stream);
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>stream_socket_server</function></member>
   <member><function>socket_export_stream</function></member>
  </simplelist>
 </refsect1>

</refentry>
