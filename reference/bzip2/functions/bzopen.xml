<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.bzopen">
 <refnamediv>
  <refname>bzopen</refname>
  <refpurpose>Opens a bzip2 compressed file</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>resource</type><type>false</type></type><methodname>bzopen</methodname>
   <methodparam><type class="union"><type>string</type><type>resource</type></type><parameter>file</parameter></methodparam>
   <methodparam><type>string</type><parameter>mode</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   <function>bzopen</function> opens a bzip2 (<filename>.bz2</filename>) file for reading or
   writing.
  </simpara>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>file</parameter></term>
    <listitem>
     <simpara>
      The name of the file to open, or an existing stream resource.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>mode</parameter></term>
    <listitem>
     <simpara>
      The modes <literal>'r'</literal> (read), and <literal>'w'</literal> (write) are supported.
      Everything else throws a <exceptionname>ValueError</exceptionname>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   If the open fails, <function>bzopen</function> returns &false;, otherwise
   it returns a pointer to the newly opened file.
  </simpara>
 </refsect1>
 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Throws a <exceptionname>ValueError</exceptionname> if <parameter>mode</parameter>
   is not exactly <literal>"r"</literal> or <literal>"w"</literal>, or if
   <parameter>file</parameter> is a <type>string</type> that is empty.
   Throws a <exceptionname>TypeError</exceptionname> if <parameter>file</parameter>
   is a <type>string</type> containing null bytes, or if it is neither a
   <type>string</type> nor a stream resource.
  </simpara>
 </refsect1>
 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       An invalid <parameter>mode</parameter> now throws a
       <exceptionname>ValueError</exceptionname>; previously,
       <function>bzopen</function> returned &false;.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>
 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>bzopen</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php

$file = "/tmp/foo.bz2";
$bz = bzopen($file, "r") or die("Couldn't open $file for reading");

bzclose($bz);

?>
]]>
   </programlisting>
  </example>
 </refsect1>
 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>bzclose</function></member>
   <member><function>bzread</function></member>
   <member><function>bzwrite</function></member>
  </simplelist>
 </refsect1>
</refentry>
